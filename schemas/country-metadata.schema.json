{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AeryxVPN per-country metadata",
  "type": "object",
  "required": ["schema_version", "metadata"],
  "properties": {
    "schema_version": {"type": "string"},
    "metadata": {
      "type": "object",
      "required": ["title", "project", "support_url", "website_url", "country_code", "country_name", "flag", "generated_at", "update_interval_hours", "validated_node_count", "balancing", "files"],
      "properties": {
        "title": {"type": "string"},
        "project": {"type": "string"},
        "support_url": {"type": "string", "format": "uri"},
        "website_url": {"type": "string", "format": "uri"},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "country_name": {"type": "string"},
        "flag": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "updated_at_local": {"type": "string"},
        "timezone": {"type": "string"},
        "update_interval_hours": {"type": "integer", "minimum": 1},
        "validated_node_count": {"type": "integer", "minimum": 1},
        "xray_compatible_node_count": {"type": "integer", "minimum": 0},
        "balancing": {"type": "object"},
        "files": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
